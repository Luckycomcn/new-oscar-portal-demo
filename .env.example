# Optional catalogue host override; restart Vite/rebuild after editing.
VITE_WIGOS_GOFC_URL=https://wmo-resource-catalogue.labs.wis2dev.io

# OpenStreetMap needs no key. Set these before starting Vite or building.
VITE_TIANDITU_KEY=
VITE_AMAP_KEY=
# Production: URL of your configured AMap security proxy, including /_AMapService.
VITE_AMAP_SERVICE_HOST=
# Local development only: VITE_* variables are exposed to the browser.
VITE_AMAP_SECURITY_JS_CODE=
