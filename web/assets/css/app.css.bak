/* ==========================================================================
   新一代 WIGOS 元数据系统门户 · 演示原型
   风格：科技简约（深色为主，浅色可选；细线、弱阴影、高对比强调色）
   ========================================================================== */

:root {
  --bg: #080d1a;
  --bg-grad-1: #0b1428;
  --bg-grad-2: #070b16;
  --panel: rgba(255, 255, 255, .035);
  --panel-2: rgba(255, 255, 255, .06);
  --line: rgba(130, 170, 230, .16);
  --line-strong: rgba(130, 170, 230, .34);
  --text: #dce7f7;
  --text-dim: #93a7c4;
  --text-mute: #6b7f9c;
  --accent: #38d6d0;
  --accent-2: #4f8cff;
  --ok: #42d392;
  --warn: #f5b544;
  --bad: #ff6f6f;
  --violet: #a78bfa;
  --radius: 10px;
  --radius-sm: 6px;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  --sans: "Inter", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei", system-ui, -apple-system, sans-serif;
  --shadow: 0 10px 30px rgba(0, 0, 0, .35);
}

body[data-theme="light"] {
  --bg: #f4f7fc;
  --bg-grad-1: #ffffff;
  --bg-grad-2: #eef3fa;
  --panel: #ffffff;
  --panel-2: #f7fafd;
  --line: rgba(20, 50, 100, .13);
  --line-strong: rgba(20, 50, 100, .26);
  --text: #10233f;
  --text-dim: #4a5f7d;
  --text-mute: #74869e;
  --accent: #0f9d97;
  --accent-2: #2f6fe0;
  --ok: #17a06a;
  --warn: #c98a10;
  --bad: #d3453f;
  --shadow: 0 8px 24px rgba(20, 40, 80, .10);
}

* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.6;
  color: var(--text);
  background:
    radial-gradient(1200px 700px at 15% -10%, rgba(56, 214, 208, .10), transparent 60%),
    radial-gradient(1000px 600px at 90% 0%, rgba(79, 140, 255, .10), transparent 60%),
    linear-gradient(180deg, var(--bg-grad-1), var(--bg-grad-2));
  background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 56px 56px;
  opacity: .28;
  mask-image: radial-gradient(900px 600px at 50% 0%, #000 0%, transparent 85%);
  z-index: 0;
}

body[data-theme="light"]::before { opacity: .5; }

a { color: var(--accent-2); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ------------------------------------------------------------------ 顶栏 */

.topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 10px 22px;
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter: blur(14px);
}

.brand { display: flex; align-items: center; gap: 11px; min-width: 0; }
.logo { width: 30px; height: 30px; color: var(--accent); flex: none; }
.brand-text { display: flex; flex-direction: column; line-height: 1.25; }
.brand-text strong { font-size: 14px; letter-spacing: .2px; font-weight: 600; }
.brand-text span { font-size: 11px; color: var(--text-mute); }

.nav { display: flex; gap: 2px; margin-left: auto; }
.nav a {
  padding: 7px 14px;
  border-radius: var(--radius-sm);
  color: var(--text-dim);
  font-size: 13px;
  border: 1px solid transparent;
}
.nav a:hover { background: var(--panel-2); color: var(--text); text-decoration: none; }
.nav a.active {
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border-color: color-mix(in srgb, var(--accent) 30%, transparent);
}

.tools { display: flex; align-items: center; gap: 8px; }
.ro-badge {
  font-size: 11px;
  color: var(--text-mute);
  border: 1px dashed var(--line-strong);
  border-radius: 999px;
  padding: 3px 10px;
  white-space: nowrap;
}

/* ------------------------------------------------------------------ 布局 */

.app {
  position: relative;
  z-index: 1;
  max-width: 1520px;
  margin: 0 auto;
  padding: 22px;
  min-height: calc(100vh - 132px);
}

.footer {
  position: relative;
  z-index: 1;
  border-top: 1px solid var(--line);
  padding: 14px 22px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px 18px;
  justify-content: space-between;
  font-size: 12px;
  color: var(--text-mute);
}

.muted { color: var(--text-mute); }
.dim { color: var(--text-dim); }
.num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

/* ------------------------------------------------------------------ 通用块 */

.panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px 18px;
}

.panel + .panel { margin-top: 16px; }

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.panel-title {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .4px;
  text-transform: uppercase;
  color: var(--text-dim);
}

.panel-title small {
  text-transform: none;
  letter-spacing: 0;
  font-weight: 400;
  color: var(--text-mute);
  margin-left: 8px;
}

h1.page-title { font-size: 21px; margin: 0 0 4px; font-weight: 650; letter-spacing: .2px; }
.page-desc { color: var(--text-dim); font-size: 13px; margin: 0 0 18px; max-width: 900px; }

.grid { display: grid; gap: 16px; }
.g2 { grid-template-columns: repeat(2, 1fr); }
.g3 { grid-template-columns: repeat(3, 1fr); }
.g4 { grid-template-columns: repeat(4, 1fr); }
.g-2-1 { grid-template-columns: 2fr 1fr; }
.g-1-2 { grid-template-columns: 1fr 2fr; }

@media (max-width: 1180px) {
  .g4 { grid-template-columns: repeat(2, 1fr); }
  .g3, .g-2-1, .g-1-2 { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .g2, .g4 { grid-template-columns: 1fr; }
  .app { padding: 14px; }
  .nav { order: 3; width: 100%; margin-left: 0; overflow-x: auto; }
  .topbar { flex-wrap: wrap; }
}

/* ------------------------------------------------------------------ 控件 */

button, .btn {
  font: inherit;
  font-size: 13px;
  color: var(--text);
  background: var(--panel-2);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 7px 14px;
  cursor: pointer;
  transition: background .15s, border-color .15s, color .15s;
}
button:hover, .btn:hover { border-color: var(--accent); color: var(--accent); }
button:disabled { opacity: .45; cursor: not-allowed; }
button.primary {
  background: color-mix(in srgb, var(--accent) 18%, transparent);
  border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  color: var(--accent);
  font-weight: 600;
}
button.primary:hover { background: color-mix(in srgb, var(--accent) 26%, transparent); }
button.ghost { background: transparent; border-color: var(--line); color: var(--text-dim); padding: 5px 10px; font-size: 12px; }
button.sm { padding: 4px 9px; font-size: 12px; }

input[type="text"], input[type="search"], input[type="number"], select, textarea {
  font: inherit;
  font-size: 13px;
  color: var(--text);
  background: var(--panel-2);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 7px 10px;
  width: 100%;
  outline: none;
}
input:focus, select:focus, textarea:focus { border-color: var(--accent); }
input::placeholder { color: var(--text-mute); }

label.field { display: block; margin-bottom: 12px; }
label.field > span.lbl {
  display: block;
  font-size: 11px;
  letter-spacing: .4px;
  text-transform: uppercase;
  color: var(--text-mute);
  margin-bottom: 5px;
}

.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--text-dim);
  background: transparent;
  cursor: pointer;
  user-select: none;
}
.chip:hover { border-color: var(--line-strong); }
.chip.on {
  border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  background: color-mix(in srgb, var(--accent) 14%, transparent);
  color: var(--accent);
}
.chip .c { font-family: var(--mono); font-size: 11px; opacity: .65; margin-left: 5px; }

.tag {
  display: inline-block;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid var(--line);
  color: var(--text-dim);
  background: var(--panel-2);
  white-space: nowrap;
}
.tag.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
.tag.warn { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
.tag.bad { color: var(--bad); border-color: color-mix(in srgb, var(--bad) 40%, transparent); }
.tag.acc { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }

/* ------------------------------------------------------------------ KPI */

.kpi {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px 16px;
  background: linear-gradient(180deg, var(--panel-2), transparent);
  position: relative;
  overflow: hidden;
}
.kpi::after {
  content: "";
  position: absolute;
  right: -30px; top: -30px;
  width: 90px; height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%);
}
.kpi .k {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .5px;
  color: var(--text-mute);
}
.kpi .v {
  font-family: var(--mono);
  font-size: 26px;
  font-weight: 600;
  line-height: 1.25;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.kpi .v small { font-size: 12px; color: var(--text-mute); font-weight: 400; }
.kpi .s { font-size: 11px; color: var(--text-mute); }

/* ------------------------------------------------------------------ 表格 */

table.data {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
table.data th, table.data td {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
}
table.data th {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .4px;
  color: var(--text-mute);
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  position: sticky;
  top: 0;
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter: blur(6px);
}
table.data th.sorted { color: var(--accent); }
table.data tbody tr:hover { background: var(--panel-2); }
table.data td.mono { font-family: var(--mono); font-size: 12px; }
table.data td .sub { display: block; font-size: 11px; color: var(--text-mute); }

.table-wrap { max-height: 62vh; overflow: auto; border: 1px solid var(--line); border-radius: var(--radius); }
.table-wrap.empty { border-style: dashed; }

.empty-state { padding: 42px 16px; text-align: center; color: var(--text-mute); font-size: 13px; }

/* ------------------------------------------------------------------ 列表/定义 */

dl.kv { margin: 0; display: grid; grid-template-columns: minmax(120px, 190px) 1fr; gap: 6px 14px; font-size: 13px; }
dl.kv dt { color: var(--text-mute); font-size: 12px; }
dl.kv dd { margin: 0; word-break: break-word; }

.section { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 14px; }
.section:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
.section h3 {
  margin: 0 0 10px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .3px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section h3 .idx {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  border-radius: 4px;
  padding: 1px 6px;
}

.cols { columns: 2; column-gap: 26px; }
@media (max-width: 860px) { .cols { columns: 1; } }

/* ------------------------------------------------------------------ 地图 */

.map-box {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  background: color-mix(in srgb, var(--bg) 60%, #05101f);
}
.map-box canvas { display: block; width: 100%; height: 100%; cursor: grab; }
.map-box.canvas-drag canvas { cursor: grabbing; }
.map-box.mode-bbox canvas { cursor: crosshair; }

.map-ui {
  position: absolute;
  display: flex;
  gap: 6px;
  z-index: 2;
}
.map-ui.tl { top: 10px; left: 10px; flex-direction: column; align-items: flex-start; }
.map-ui.tr { top: 10px; right: 10px; }
.map-ui.br { bottom: 10px; right: 10px; }
.map-ui.bl { bottom: 10px; left: 10px; flex-direction: column; align-items: flex-start; }

.map-ui button { background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(6px); }

.map-legend {
  font-size: 11px;
  color: var(--text-dim);
  background: color-mix(in srgb, var(--bg) 78%, transparent);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
  backdrop-filter: blur(6px);
}
.map-legend .row { display: flex; align-items: center; gap: 7px; margin-top: 3px; }
.map-legend .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
.map-legend .ttl { font-size: 10px; text-transform: uppercase; letter-spacing: .4px; color: var(--text-mute); }

.map-tip {
  position: absolute;
  z-index: 3;
  pointer-events: none;
  font-size: 12px;
  background: color-mix(in srgb, var(--bg) 92%, transparent);
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  padding: 6px 9px;
  box-shadow: var(--shadow);
  max-width: 260px;
}
.map-tip b { display: block; font-size: 12px; }
.map-tip span { color: var(--text-mute); font-family: var(--mono); font-size: 11px; }

/* ------------------------------------------------------------------ 条形图 */

.bars { display: flex; flex-direction: column; gap: 7px; }
.bar-row { display: grid; grid-template-columns: 150px 1fr 56px; gap: 10px; align-items: center; font-size: 12px; }
.bar-row .bl { color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-row .bt { height: 7px; border-radius: 4px; background: var(--panel-2); overflow: hidden; border: 1px solid var(--line); }
.bar-row .bf { height: 100%; background: linear-gradient(90deg, var(--accent-2), var(--accent)); }
.bar-row .bv { font-family: var(--mono); font-size: 11px; color: var(--text-mute); text-align: right; }

/* ------------------------------------------------------------------ 架构图 */

.arch {
  display: grid;
  grid-template-columns: 1fr 60px 1fr 60px 1fr;
  align-items: stretch;
  gap: 0;
}
.arch .node {
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  padding: 12px;
  background: var(--panel);
}
.arch .node.ro { border-style: dashed; }
.arch .node b { display: block; font-size: 13px; margin-bottom: 3px; }
.arch .node .m { font-size: 11px; color: var(--text-mute); }
.arch .arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  font-size: 12px;
  position: relative;
}
.arch .arrow::before {
  content: "";
  position: absolute;
  left: 4px; right: 4px;
  border-top: 1px dashed var(--line-strong);
}
.arch .arrow span { background: var(--bg); padding: 0 4px; z-index: 1; font-size: 11px; }
@media (max-width: 900px) { .arch { grid-template-columns: 1fr; gap: 8px; } .arch .arrow { display: none; } }

/* ------------------------------------------------------------------ 杂项 */

.toast {
  position: fixed;
  bottom: 26px;
  left: 50%;
  transform: translateX(-50%);
  background: color-mix(in srgb, var(--bg) 94%, transparent);
  border: 1px solid var(--accent);
  color: var(--text);
  padding: 9px 18px;
  border-radius: 999px;
  font-size: 13px;
  z-index: 90;
  box-shadow: var(--shadow);
}

.boot { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 90px 0; color: var(--text-mute); }
.boot-ring {
  width: 34px; height: 34px;
  border: 2px solid var(--line-strong);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.skel { height: 12px; border-radius: 4px; background: var(--panel-2); animation: pulse 1.4s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }

.split { display: grid; grid-template-columns: 320px 1fr; gap: 16px; align-items: start; }
@media (max-width: 1000px) { .split { grid-template-columns: 1fr; } }

.side { position: sticky; top: 74px; }
@media (max-width: 1000px) { .side { position: static; } }

.pager { display: flex; align-items: center; gap: 8px; justify-content: flex-end; margin-top: 12px; font-size: 12px; color: var(--text-mute); }
.pager select { width: auto; }

.mono-box {
  font-family: var(--mono);
  font-size: 12px;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 12px;
  overflow: auto;
  max-height: 320px;
  color: var(--text-dim);
}

.notice {
  border-left: 2px solid var(--accent);
  background: color-mix(in srgb, var(--accent) 8%, transparent);
  padding: 9px 12px;
  font-size: 12px;
  color: var(--text-dim);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

ul.tight { margin: 0; padding-left: 18px; }
ul.tight li { margin-bottom: 4px; font-size: 13px; }

.tree { font-size: 13px; max-height: 260px; overflow: auto; border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px; }
.tree .node { padding-left: 12px; border-left: 1px solid var(--line); margin-left: 4px; }
.tree .leaf { display: flex; align-items: center; gap: 6px; padding: 2px 0; cursor: pointer; }
.tree .leaf:hover { color: var(--accent); }
.tree .tw { cursor: pointer; color: var(--text-mute); font-family: var(--mono); width: 12px; display: inline-block; }

.filter-summary { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
